;; BN254 curve primitives: tower-field arithmetic (Fp2/Fp6/Fp12),
;; elliptic-curve points (G1/G2), and pairing-line types.
;;
;; Depends on [circuit_kit] for the Boolean helpers used inside g1.
;;
;; [include_subdirs unqualified] is required: the modules under towers/,
;; ec/ and lines/ are mutually recursive across those directories (e.g.
;; bn254_params references towers and ec, towers/fp_const references
;; lines, lines references towers and ec). A mutually-recursive module
;; set cannot be split into separate dune libraries — a library is an
;; acyclic compilation unit — so bn254 is one library flattened across
;; its subdirectories.

(include_subdirs unqualified)

(library
 (name proof_conversion_bn254)
 (libraries
  core_kernel
  bignum_bigint
  pickles
  snarky.backendless
  snarky_foreign_field
  proof_conversion_circuit_kit)
 (instrumentation
  (backend bisect_ppx))
 (preprocess
  (pps ppx_version ppx_jane)))
