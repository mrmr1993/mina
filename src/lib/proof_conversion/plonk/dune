;; PLONK proof-conversion: 24 base circuits (zkp0-23) that progressively
;; verify a non-native PLONK proof, plus the transcript (SHA-256 / Fiat-
;; Shamir) and KZG accumulator helpers consumed by them.
;;
;; Depends on [groth16] for the shared accumulator-hashing primitives
;; ([Accumulator], [Accumulator_hash], [Witness_tracker]) that both
;; proof systems reuse.
;;
;; [include_subdirs unqualified] is required: the modules under
;; transcript/ and kzg/ are mutually recursive with the plonk-root
;; modules (e.g. transcript/fiat_shamir references Accumulator and
;; Proof; accumulator references transcript/uint32; kzg/kzg references
;; Accumulator; circuits references Kzg_accumulator). A mutually-
;; recursive module set cannot be split into separate dune libraries —
;; a library is an acyclic compilation unit — so plonk is one library
;; flattened across its subdirectories.

(include_subdirs unqualified)

(library
 (name proof_conversion_plonk)
 (libraries
  core_kernel
  bignum_bigint
  digestif.ocaml
  kimchi_pasta
  pickles
  pickles_types
  promise
  random_oracle
  snarky.backendless
  snarky_foreign_field
  yojson
  proof_conversion_bn254
  proof_conversion_circuit_kit
  proof_conversion_groth16)
 (instrumentation
  (backend bisect_ppx))
 (preprocess
  (pps ppx_version ppx_jane)))

;; Embed the precomputed pairing-line tables as OCaml string constants so
;; the circuits have no runtime dependency on a workspace-relative data
;; directory. The JSON in data/ remains the source of truth.

(rule
 (target plonk_line_data.ml)
 (deps data/g2_lines.json data/tau_lines.json)
 (action
  (with-stdout-to
   plonk_line_data.ml
   (bash
    "printf 'let g2_lines_json = {json|'; cat data/g2_lines.json; printf '|json}\\n\\nlet tau_lines_json = {json|'; cat data/tau_lines.json; printf '|json}\\n'"))))
