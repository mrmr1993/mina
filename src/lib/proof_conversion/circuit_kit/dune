;; Shared circuit-kit primitives consumed by every proof_conversion
;; sub-library. Leaf in the proof_conversion dependency graph: depends
;; only on Pickles, Snarky, the foreign-field gadget library and
;; key_cache (used by Cache_config).

(include_subdirs no)

(library
 (name proof_conversion_circuit_kit)
 (libraries
  core_kernel
  key_cache
  pickles
  snarky.backendless
  snarky_foreign_field)
 (instrumentation
  (backend bisect_ppx))
 (preprocess
  (pps ppx_version ppx_jane)))
